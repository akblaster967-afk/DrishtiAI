# Copy this file to backend/.env for local development.
# Never commit backend/.env or put real credentials in this example file.

# Replace this with a long, random, unique secret before using authentication.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VERIFYSHIELD_SESSION_SECRET=replace-with-a-long-random-secret

# Frontend origin used in authentication links.
VERIFYSHIELD_FRONTEND_URL=http://localhost:5173

# Set true only when using HTTPS with secure cookie configuration.
VERIFYSHIELD_SESSION_SECURE=false

# Optional: configure SMTP to enable email verification/password reset messages.
VERIFYSHIELD_SMTP_HOST=
VERIFYSHIELD_SMTP_PORT=587
VERIFYSHIELD_SMTP_USERNAME=
VERIFYSHIELD_SMTP_PASSWORD=
VERIFYSHIELD_SMTP_FROM_EMAIL=
VERIFYSHIELD_SMTP_USE_TLS=true
