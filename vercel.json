{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/api/:path*",
          "destination": "https://drishti-ai-backend.onrender.com/api/:path*"
        },
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  }
}
